<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Galaxy</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #050505;
      color: #fff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .app {
      min-height: 100vh;
      background:
        radial-gradient(circle at 20% 20%, rgba(138,43,226,.18), transparent 30%),
        radial-gradient(circle at 80% 80%, rgba(255,45,170,.12), transparent 30%),
        #050505;
    }

    /* Splash */

    #splash {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #050505;
      transition: opacity .6s ease;
    }

    .logo {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 55px;
      background: linear-gradient(135deg, #8a2be2, #ff2daa, #00bfff);
      box-shadow:
        0 0 25px rgba(138,43,226,.6),
        0 0 70px rgba(255,45,170,.25);
      animation: galaxyPulse 2s infinite;
    }

    .brand {
      margin-top: 22px;
      font-size: 36px;
      font-weight: bold;
      background: linear-gradient(90deg, #8a2be2, #ff2daa, #00bfff);
      -webkit-background-clip: text;
      color: transparent;
    }

    .tagline {
      color: #999;
      margin-top: 8px;
    }

    @keyframes galaxyPulse {
      0%, 100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.08);
      }
    }

    /* Onboarding */

    .screen {
      display: none;
      min-height: 100vh;
      padding: 35px 22px;
    }

    .screen.active {
      display: flex;
      flex-direction: column;
    }

    .onboarding {
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .planet {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      margin-bottom: 40px;
      background:
        radial-gradient(circle at 35% 30%, #fff, #ff2daa 8%, #8a2be2 35%, #17101f 70%);
      box-shadow:
        0 0 35px rgba(138,43,226,.7),
        0 0 100px rgba(255,45,170,.25);
    }

    h1 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .gradient-text {
      background: linear-gradient(90deg, #8a2be2, #ff2daa);
      -webkit-background-clip: text;
      color: transparent;
    }

    .description {
      color: #aaa;
      line-height: 1.8;
      max-width: 340px;
      margin-bottom: 35px;
    }

    .dots {
      display: flex;
      gap: 8px;
      margin-bottom: 25px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #444;
    }

    .dot.active {
      width: 25px;
      background: linear-gradient(90deg, #8a2be2, #ff2daa);
    }

    .btn {
      width: 100%;
      max-width: 360px;
      border: none;
      padding: 16px;
      border-radius: 16px;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      background: linear-gradient(90deg, #8a2be2, #ff2daa);
      box-shadow: 0 8px 30px rgba(138,43,226,.25);
    }

    .secondary {
      margin-top: 15px;
      background: transparent;
      border: 1px solid #333;
      box-shadow: none;
      color: #aaa;
    }

    /* Home */

    .home {
      padding-bottom: 90px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0 25px;
    }

    .galaxy-title {
      font-size: 27px;
      font-weight: bold;
      background: linear-gradient(90deg, #8a2be2, #ff2daa, #00bfff);
      -webkit-background-clip: text;
      color: transparent;
    }

    .icons {
      display: flex;
      gap: 10px;
    }

    .icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid #292929;
      background: #101014;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
    }

    .stories {
      display: flex;
      gap: 13px;
      overflow-x: auto;
      padding: 5px 0 25px;
    }

    .story {
      min-width: 65px;
      text-align: center;
      font-size: 12px;
      color: #aaa;
    }

    .story-img {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      padding: 3px;
      background: linear-gradient(135deg, #8a2be2, #ff2daa);
      margin-bottom: 5px;
    }

    .story-img div {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #222;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
    }

    .post {
      background: #101014;
      border: 1px solid #202025;
      border-radius: 20px;
      margin-bottom: 18px;
      overflow: hidden;
    }

    .post-head {
      display: flex;
      align-items: center;
      padding: 15px;
      gap: 10px;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #8a2be2, #ff2daa);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .post-name {
      font-weight: bold;
    }

    .post-time {
      color: #777;
      font-size: 12px;
      margin-top: 3px;
    }

    .post-image {
      height: 260px;
      background:
        radial-gradient(circle at 40% 40%, #ff2daa, transparent 10%),
        radial-gradient(circle at 60% 60%, #8a2be2, transparent 25%),
        #08080d;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 60px;
    }

    .post-text {
      padding: 15px;
      color: #ccc;
      line-height: 1.6;
    }

    .post-actions {
      display: flex;
      justify-content: space-around;
      padding: 12px;
      border-top: 1px solid #202025;
      color: #aaa;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 72px;
      background: rgba(10,10,12,.94);
      backdrop-filter: blur(15px);
      border-top: 1px solid #222;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 20;
    }

    .nav-item {
      color: #777;
      text-align: center;
      font-size: 12px;
    }

    .nav-item span {
      display: block;
      font-size: 22px;
      margin-bottom: 3px;
    }

    .nav-item.active {
      color: #ff2daa;
    }

    .create {
      width: 50px;
      height: 50px;
      border-radius: 17px;
      margin-top: -25px;
      background: linear-gradient(135deg, #8a2be2, #ff2daa);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 28px;
      box-shadow: 0 8px 25px rgba(138,43,226,.5);
    }

    @media (min-width: 700px) {
      .screen {
        max-width: 600px;
        margin: auto;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- Splash -->
  <div id="splash">
    <div class="logo">🌌</div>
    <div class="brand">Galaxy</div>
    <div class="tagline">Explore Your Universe</div>
  </div>

  <!-- Onboarding -->
  <section id="onboarding" class="screen onboarding active">

    <div class="planet">🌌</div>

    <h1>
      مرحبًا بك في
      <span class="gradient-text">Galaxy</span>
    </h1>

    <p class="description">
      عالم جديد للتواصل واكتشاف الأشخاص ومشاركة لحظاتك
      في تجربة اجتماعية مختلفة.
    </p>

    <div class="dots">
      <div class="dot active"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>

    <button class="btn" onclick="showHome()">
      ابدأ الآن 🚀
    </button>

    <button class="btn secondary" onclick="showHome()">
      تخطي
    </button>

  </section>

  <!-- Home -->
  <section id="home" class="screen home">

    <div class="topbar">

      <div class="galaxy-title">🌌 Galaxy</div>

      <div class="icons">
        <div class="icon">🔔</div>
        <div class="icon">💬</div>
      </div>

    </div>

    <!-- Stories -->
    <div class="stories">

      <div class="story">
        <div class="story-img">
          <div>＋</div>
        </div>
        قصتك
      </div>

      <div class="story">
        <div class="story-img">
          <div>👤</div>
        </div>
        Sara
      </div>

      <div class="story">
        <div class="story-img">
          <div>👨</div>
        </div>
        Ahmed
      </div>

      <div class="story">
        <div class="story-img">
          <div>👩</div>
        </div>
        Esraa
      </div>

      <div class="story">
        <div class="story-img">
          <div>🧑</div>
        </div>
        Omar
      </div>

    </div>

    <!-- Post -->
    <article class="post">

      <div class="post-head">

        <div class="avatar">👤</div>

        <div>
          <div class="post-name">Galaxy User</div>
          <div class="post-time">منذ 10 دقائق</div>
        </div>

      </div>

      <div class="post-image">
        🌌
      </div>

      <div class="post-text">
        استكشف عالمك، شارك لحظاتك، وابنِ مجرتك الخاصة. 🚀
      </div>

      <div class="post-actions">
        <span>❤️ 128</span>
        <span>💬 24</span>
        <span>🚀 مشاركة</span>
        <span>🔖</span>
      </div>

    </article>

  </section>

  <!-- Navigation -->

  <nav id="bottomNav" class="bottom-nav" style="display:none;">

    <div class="nav-item active">
      <span>🏠</span>
      الرئيسية
    </div>

    <div class="nav-item">
      <span>🔍</span>
      بحث
    </div>

    <div class="create">
      ＋
    </div>

    <div class="nav-item">
      <span>🎬</span>
      Reels
    </div>

    <div class="nav-item">
      <span>👤</span>
      الملف
    </div>

  </nav>

</div>

<script>

  // Splash
  setTimeout(function() {
    const splash = document.getElementById("splash");

    splash.style.opacity = "0";

    setTimeout(function() {
      splash.style.display = "none";
    }, 600);

  }, 2200);


  // Go Home
  function showHome() {

    document.getElementById("onboarding").classList.remove("active");

    document.getElementById("home").classList.add("active");

    document.getElementById("bottomNav").style.display = "flex";

    window.scrollTo(0, 0);
  }

</script>

</body>
</html>